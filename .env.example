# Combined server-side template. The local Express service reads a repository-
# root `.env` as a fallback; Vercel values belong in Project Settings instead.
# Never copy this credential into frontend code or prefix it with VITE_.
GEMINI_API_KEY=replace_with_your_own_key

# Local Express configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Preview model IDs can change. Confirm these in Google AI Studio on hack day.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
GEMINI_SUMMARY_MODEL=gemini-3.7-flash
LIVE_TOKEN_TTL_MINUTES=30
LIVE_NEW_SESSION_TTL_SECONDS=60

# Public live-token abuse protection. The local Express server keeps this
# fixed-window counter in memory and keys it by client IP.
LIVE_TOKEN_RATE_LIMIT_MAX=60
LIVE_TOKEN_RATE_LIMIT_WINDOW_SECONDS=600

# Keep 0 when Express is reached directly. Set this only to the exact number of
# trusted reverse-proxy hops that overwrite X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Vercel only: must match the @vercel/firewall rate-limit rule.
LIVE_TOKEN_RATE_LIMIT_ID=lingua-live-token
