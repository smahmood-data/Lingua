# Server-only Gemini credential. Never prefix this with VITE_.
GEMINI_API_KEY=replace_with_your_own_key

# Local server configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Preview model IDs can change. Confirm these in Google AI Studio on hack day.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
GEMINI_SUMMARY_MODEL=gemini-3.7-flash
LIVE_TOKEN_TTL_MINUTES=30
LIVE_NEW_SESSION_TTL_SECONDS=60
